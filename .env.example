# ==============================================================================
# FitFlow Environment Variables Template (.env.example)
# Copy to .env and fill in real values. NEVER commit .env to version control.
# ==============================================================================

# Transactional Database (MySQL 8)
MYSQL_URL=jdbc:mysql://localhost:3306/fitflow?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USER=fitflow_app
MYSQL_PASSWORD=change_me_mysql_password

# Test Database for verification runs
MYSQL_TEST_URL=jdbc:mysql://localhost:3306/fitflow_test?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_TEST_USER=fitflow_app
MYSQL_TEST_PASSWORD=change_me_mysql_password

# Memory & Audit Database (PostgreSQL 16/17)
PG_URL=jdbc:postgresql://localhost:5432/fitflow
PG_USER=fitflow_app
PG_PASSWORD=change_me_pg_password

# Test Database for PostgreSQL verification runs
PG_TEST_URL=jdbc:postgresql://localhost:5432/fitflow_test
PG_TEST_USER=fitflow_app
PG_TEST_PASSWORD=change_me_pg_password

# Message Broker (RabbitMQ)
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest
MESSAGING_MODE=rabbit

# Mail Service (GreenMail dev defaults to port 3025)
SMTP_HOST=localhost
SMTP_PORT=3025
SMTP_USER=
SMTP_PASSWORD=

# Security & Secrets
# JWT Secret: HMAC-SHA256 key (at least 32 bytes, 256 bits)
JWT_SECRET=replace_with_a_secure_random_base64_secret_key_minimum_32_bytes_long

# Master Encryption Key: 256-bit AES-GCM key (32 bytes Base64-encoded)
# In dev profile, if absent, the app generates one in .local/master.key
APP_MASTER_KEY=k8sX+dummyMasterKeyBase6432BytesLengthPadding==

# Google Gemini API Key (Optional in .env; normally managed dynamically via admin app_secrets)
GEMINI_API_KEY=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
