    "base": "0",
    "dropdown": "1000",
    "sticky": "1100",
    "modalBackdrop": "1200",
    "modal": "1300",
    "popover": "1400",
    "toast": "1500",
    "tooltip": "1600"
  },
  "motion": {
    "duration": {
      "fast": "150ms",
      "normal": "250ms",
      "slow": "350ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.4, 0.0, 0.2, 1)",
      "decelerate": "cubic-bezier(0.0, 0.0, 0.2, 1)",
      "accelerate": "cubic-bezier(0.4, 0.0, 1, 1)"
    },
    "reducedMotion": {
      "duration": "0.01ms"
    }
  },
